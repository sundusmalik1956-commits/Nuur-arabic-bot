# حالات المستخدمين أثناء الدرس
user_sessions = {}

async def send_lesson(user_id: int, lang: str):
    """إرسال الدرس الأول"""
    bot = None
    try:
        # الحصول على البوت من السياق
        from bot import NoorBot
        bot = NoorBot.app.bot
        
        # تهيئة جلسة المستخدم
        user_sessions[user_id] = {
            'current_step': 0,
            'completed_skills': [],
            'quiz_index': 0,
            'current_skill': None
        }
        
        # إرسال التمهيد
        await send_introduction(bot, user_id, lang)
        
    except Exception as e:
        logger.error(f"خطأ في إرسال الدرس الأول للمستخدم {user_id}: {e}")
        if bot:
            await bot.send_message(
                user_id,
                "حدث خطأ في إرسال الدرس. الرجاء المحاولة مرة أخرى."
            )

async def send_introduction(bot, user_id: int, lang: str):
    """إرسال التمهيد"""
    intro = LESSON_DATA['introduction']
    text = intro['text']
    
    keyboard = [[InlineKeyboardButton(
        "📖 ابدأ الدرس", callback_data="skill_introduction_start"
    )]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    # إرسال الصورة مع النص
    try:
        await bot.send_photo(
            user_id,
            photo=intro['image'],
            caption=text,
            reply_markup=reply_markup
        )
    except Exception as e:
        logger.warning(f"خطأ في إرسال صورة التمهيد: {e}")
        await bot.send_message(
            user_id,
            text,
            reply_markup=reply_markup
        )

async def skill_introduction_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
