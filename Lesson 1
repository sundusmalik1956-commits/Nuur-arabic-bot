async def vocabulary_quiz(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """بدء اختبار المفردات"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    # بدء الاختبار
    user_sessions[user_id]['current_skill'] = 'vocabulary'
    user_sessions[user_id]['quiz_index'] = 0
    
    await send_quiz_question(query, 'vocabulary', lang)

async def send_quiz_question(query, skill: str, lang: str):
    """إرسال سؤال اختبار"""
    user_id = query.from_user.id
    session = user_sessions.get(user_id, {})
    quiz_index = session.get('quiz_index', 0)
    
    quizzes = QUIZZES.get(skill, [])
    if quiz_index >= len(quizzes):
        # انتهى الاختبار
        await complete_skill(user_id, skill)
        await move_to_next_skill(query, skill)
        return
    
    quiz = quizzes[quiz_index]
    
    keyboard = []
    for i, option in enumerate(quiz['options']):
        keyboard.append([InlineKeyboardButton(
            option, callback_data=f"answer_{skill}_{i}"
        )])
    
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await query.message.reply_text(
        f"❓ {quiz['question']}",
        reply_markup=reply_markup
    )

async def handle_answer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """معالج الإجابات"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    # تحليل البيانات
    data = query.data.split('_')
    if len(data) < 3:
        return
    
    skill = data[1]
    answer_index = int(data[2])
    
    # الحصول على السؤال الحالي
    session = user_sessions.get(user_id, {})
    quiz_index = session.get('quiz_index', 0)
    
    quizzes = QUIZZES.get(skill, [])
    if quiz_index >= len(quizzes):
        return
    
    quiz = quizzes[quiz_index]
    
    # التحقق من الإجابة
    if answer_index == quiz['correct']:
        # إجابة صحيحة
        await query.message.reply_text(
            f"✅ صحيح!\n\n{quiz['explanation']}"
        )
        
        # الانتقال للسؤال التالي
        session['quiz_index'] = quiz_index + 1
        user_sessions[user_id] = session
        
        if session['quiz_index'] >= len(quizzes):
            # انتهى الاختبار
            await complete_skill(user_id, skill)
            await move_to_next_skill(query, skill)
        else:
            # سؤال تالي
            await send_quiz_question(query, skill, lang)
    else:
        # إجابة خاطئة
        keyboard = [[InlineKeyboardButton(
            "🔄 حاول مرة أخرى", callback_data=f"retry_{skill}"
        )]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await query.message.reply_text(
            "❌ الإجابة غير صحيحة. حاول مرة أخرى.",
            reply_markup=reply_markup
        )

async def retry_quiz(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """إعادة محاولة الاختبار"""
    query = update.callback_query
    await query.answer()
    
    user_id = query.from_user.id
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    skill = query.data.split('_')[1]
    
    # إعادة السؤال الحالي
    await send_quiz_question(query, skill, lang)

async def move_to_next_skill(query, current_skill: str):
    """الانتقال للمهارة التالية"""
    user_id = query.from_user.id
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    # ترتيب المهارات
    skills_order = ['introduction', 'vocabulary', 'grammar', 'reading', 'listening', 'conversation', 'writing']
    current_index = skills_order.index(current_skill)
    
    if current_index + 1 < len(skills_order):
        next_skill = skills_order[current_index + 1]
        
        # إرسال المهارة التالية
        if next_skill == 'grammar':
            await send_grammar(query, context)
        elif next_skill == 'reading':
            await send_reading(query, context)
        elif next_skill == 'listening':
            await send_listening(query, context)
        elif next_skill == 'conversation':
            await send_conversation(query, context)
        elif next_skill == 'writing':
            await send_writing(query, context)
    else:
        # انتهى الدرس
        await finish_lesson(query)

async def complete_skill(user_id: int, skill: str):
    """تسجيل إكمال مهارة"""
    session = user_sessions.get(user_id, {})
    completed = session.get('completed_skills', [])
    
    if skill not in completed:
        completed.append(skill)
        session['completed_skills'] = completed
        user_sessions[user_id] = session
        
        # تحديث قاعدة البيانات
        user = db.get_user(user_id)
        if user:
            current_lesson = user.get('current_lesson', 1)
            completed_skills = user.get('completed_skills', {})
            
            if str(current_lesson) not in completed_skills:
                completed_skills[str(current_lesson)] = []
            
            if skill not in completed_skills[str(current_lesson)]:
                completed_skills[str(current_lesson)].append(skill)
                db.update_user(user_id, {'completed_skills': completed_skills})
        
        # التحقق من إكمال الدرس
        await check_lesson_completion(user_id)

async def check_lesson_completion(user_id: int):
    """التحقق من إكمال جميع مهارات الدرس"""
    from bot import NoorBot
    
    session = user_sessions.get(user_id, {})
    completed = session.get('completed_skills', [])
    
    # جميع المهارات المطلوبة
    required = ['introduction', 'vocabulary', 'grammar', 'reading', 'listening', 'conversation', 'writing']
    
    if all(skill in completed for skill in required):
        # إكمال الدرس
        bot = NoorBot()
        await bot.complete_lesson(user_id, 1)

