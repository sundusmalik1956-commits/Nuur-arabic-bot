async def handle_text_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """معالج الرسائل النصية (للمحادثة والكتابة)"""
    user_id = update.effective_user.id
    text = update.message.text
    
    session = user_sessions.get(user_id, {})
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    # التحقق من وضع المحادثة
    if 'conversation_step' in session:
        step = session['conversation_step']
        
        if step == 1:
            # السؤال الأول: الاسم
            await update.message.reply_text(
                f"👋 مرحباً {text}!\n\n"
                f"**السؤال 2:** من أين أنت؟"
            )
            session['conversation_step'] = 2
            user_sessions[user_id] = session
            
        elif step == 2:
            # السؤال الثاني: البلد
            await update.message.reply_text(
                f"🌍 أنت من {text}!\n\n"
                f"**السؤال 3:** كم عمرك؟"
            )
            session['conversation_step'] = 3
            user_sessions[user_id] = session
            
        elif step == 3:
            # السؤال الثالث: العمر
            await update.message.reply_text(
                f"🎂 عمرك {text}!\n\n"
                f"**السؤال 4:** ماذا تعمل أو تدرس؟"
            )
            session['conversation_step'] = 4
            user_sessions[user_id] = session
            
        elif step == 4:
            # السؤال الرابع: العمل/الدراسة
            await update.message.reply_text(
                f"💼 {text}! رائع!\n\n"
                f"**السؤال 5:** ماذا تحب أن تفعل في وقت الفراغ؟"
            )
            session['conversation_step'] = 5
            user_sessions[user_id] = session
            
        elif step == 5:
            # السؤال الخامس: الهوايات
            await update.message.reply_text(
                f"🌟 تحب {text}! جميل!\n\n"
                "🎉 أحسنت! لقد أكملت المحادثة بنجاح!\n"
                "لقد تعلمت كيف تتحدث عن نفسك بالعربية."
            )
            
            # تسجيل إكمال المحادثة
            await complete_skill(user_id, 'conversation')
            
            # الانتقال للكتابة
            await send_writing_to_user(update, user_id, lang)
            
            # حذف حالة المحادثة
            del session['conversation_step']
            user_sessions[user_id] = session
    
    # التحقق من وضع الكتابة
    elif session.get('writing_mode'):
        await process_writing(update, context, text)
        
        # إلغاء وضع الكتابة
        session['writing_mode'] = False
        user_sessions[user_id] = session

async def send_writing_to_user(update, user_id: int, lang: str):
    """إرسال مهمة الكتابة للمستخدم"""
    writing = LESSON_DATA['writing']
    
    keyboard = [[InlineKeyboardButton(
        "✍️ أرسل كتابتك", callback_data="skill_writing_start"
    )]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    await update.message.reply_text(
        writing['text'],
        reply_markup=reply_markup
    )

async def process_writing(update: Update, context: ContextTypes.DEFAULT_TYPE, text: str):
    """معالجة الكتابة وتصحيحها"""
    user_id = update.effective_user.id
    user = db.get_user(user_id)
    lang = user['language'] if user else 'ar'
    
    # استخدام Gemini للتصحيح
    try:
        from bot import gemini
        
        if gemini:
            correction = await gemini.correct_writing(text, lang)
            await update.message.reply_text(
                f"📝 **تقييم كتابتك:**\n\n{correction}"
            )
        else:
            # رد بسيط في حالة عدم وجود Gemini
            await update.message.reply_text(
                "📝 شكراً لك على كتابتك!\n\n"
                "نصك:\n"
                f"\"{text}\"\n\n"
                "🌟 أحسنت! واصل التدريب على الكتابة."
            )
        
        # تسجيل إكمال الكتابة
        await complete_skill(user_id, 'writing')
        
        # الانتقال لإنهاء الدرس
        await finish_lesson_direct(update, user_id)
        
    except Exception as e:
        logger.error(f"خطأ في تصحيح الكتابة: {e}")
        await update.message.reply_text(
            "حدث خطأ في تصحيح كتابتك. ولكن لا تقلق!\n"
            "استمر في الممارسة وستتحسن بإذن الله."
        )
        
        # تسجيل إكمال الكتابة حتى في حالة الخطأ
        await complete_skill(user_id, 'writing')
        await finish_lesson_direct(update, user_id)

async def finish_lesson_direct(update, user_id: int):
    """إنهاء الدرس مباشرة"""
    session = user_sessions.get(user_id, {})
    completed = session.get('completed_skills', [])
    
    if len(completed) >= 7:
        await update.message.reply_text(
            "🎉 **مبروك! لقد أكملت جميع مهارات الدرس الأول!**\n\n"
            "لقد تعلمت:\n"
            "• كيف تقدم نفسك بالعربية\n"
            "• المفردات الأساسية للتعارف\n"
            "• قواعد الجملة الاسمية\n"
            "• القراءة والاستماع والفهم\n"
            "• المحادثة والكتابة\n\n"
            "🌟 استمر في التعلم! الدرس الثاني في انتظارك."
        )
        
        # إكمال الدرس في النظام
        from bot import NoorBot
        bot = NoorBot()
        await bot.complete_lesson(user_id, 1)

# ربط المعالجات مع البوت الرئيسي
def register_handlers(app):
    """تسجيل معالجات الدرس"""
    # معالجات الاختبارات
    app.add_handler(CallbackQueryHandler(
        skill_introduction_start, pattern="^skill_introduction_start$"
    ))
    app.add_handler(CallbackQueryHandler(
        vocabulary_quiz, pattern="^skill_vocabulary_quiz$"
    ))
    app.add_handler(CallbackQueryHandler(
        handle_answer, pattern="^answer_"
    ))
    app.add_handler(CallbackQueryHandler(
        retry_quiz, pattern="^retry_"
    ))
    
    # معالجات المهارات
    app.add_handler(CallbackQueryHandler(
        send_grammar, pattern="^skill_grammar_quiz$"
    ))
    app.add_handler(CallbackQueryHandler(
        send_reading, pattern="^skill_reading_quiz$"
    ))
    app.add_handler(CallbackQueryHandler(
        send_listening, pattern="^skill_listening_quiz$"
    ))
    app.add_handler(CallbackQueryHandler(
        conversation_start, pattern="^skill_conversation_start$"
    ))
    app.add_handler(CallbackQueryHandler(
        writing_start, pattern="^skill_writing_start$"
    ))
    
    # معالج الرسائل النصية
    app.add_handler(MessageHandler(
        filters.TEXT & ~filters.COMMAND, handle_text_message
    ))
